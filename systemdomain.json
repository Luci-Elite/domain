<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stock & Invoice System</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<style>
:root{--ink:#16222e;--mut:#5d6b79;--line:#d9dfe5;--bg:#eef1f4;--card:#fff;--nav:#17314a;--navt:#c9d6e2;--acc:#0b6e8a;--accd:#08556b;--ok:#18794e;--bad:#b42318;--warn:#a15c07}
*{box-sizing:border-box}
body{margin:0;font:14px/1.45 "Segoe UI",Tahoma,Arial,sans-serif;color:var(--ink);background:var(--bg)}
h1,h2,h3{margin:0}
button{font:inherit;cursor:pointer}
input,select,textarea{font:inherit;padding:7px 9px;border:1px solid var(--line);border-radius:5px;background:#fff;color:var(--ink);width:100%}
input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
label{display:block;font-size:12.5px;color:var(--mut);margin-bottom:3px}
.btn{background:var(--acc);color:#fff;border:0;border-radius:5px;padding:8px 14px;font-weight:600}
.btn:hover{background:var(--accd)}
.btn.sec{background:#fff;color:var(--ink);border:1px solid var(--line)}
.btn.sec:hover{background:#f3f5f7}
.btn.bad{background:var(--bad)}
.btn.sm{padding:4px 9px;font-size:12.5px}
#login{min-height:100vh;display:grid;place-items:center;padding:16px}
.lbox{background:var(--card);width:340px;max-width:100%;padding:28px;border-radius:8px;border:1px solid var(--line)}
.lbox h1{font-size:20px;margin-bottom:4px}
.lbox p{color:var(--mut);margin:0 0 18px}
.lbox .f{margin-bottom:12px}
#app{display:none;min-height:100vh}
#side{width:210px;background:var(--nav);color:var(--navt);position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column}
#side .brand{padding:16px;color:#fff;font-weight:700;font-size:15px;border-bottom:1px solid #284a68}
#side .brand small{display:block;font-weight:400;color:var(--navt);font-size:12px}
#side nav{flex:1;padding:8px 0;overflow:auto}
#side a{display:block;padding:10px 16px;color:var(--navt);text-decoration:none;cursor:pointer;border-left:3px solid transparent}
#side a:hover{background:#1f3f5e}
#side a.on{background:#1f3f5e;color:#fff;border-left-color:#5cc8e6}
#side .me{padding:12px 16px;border-top:1px solid #284a68;font-size:12.5px}
#main{margin-left:210px;padding:20px;max-width:1250px}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap}
.top h2{font-size:20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:7px;padding:14px;margin-bottom:14px}
.grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
table{width:100%;border-collapse:collapse;background:#fff}
th,td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{background:#f4f6f8;font-size:12.5px;color:var(--mut);font-weight:600;white-space:nowrap}
td.r,th.r{text-align:right}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:7px}
.tw table{border:0}
.tag{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;font-weight:600}
.tag.ok{background:#dcf3e7;color:var(--ok)}.tag.bad{background:#fde4e1;color:var(--bad)}.tag.warn{background:#fdf0d5;color:var(--warn)}
.stat{background:#fff;border:1px solid var(--line);border-radius:7px;padding:12px}
.stat b{display:block;font-size:22px}
.stat span{color:var(--mut);font-size:12.5px}
.mut{color:var(--mut)}
.line{border:1px solid var(--line);border-radius:7px;padding:12px;margin-bottom:10px;background:#fbfcfd}
.bar{display:flex;gap:8px;flex-wrap:wrap;align-items:end}
.bar>div{flex:1;min-width:130px}
#modalBg{display:none;position:fixed;inset:0;background:rgba(10,20,30,.5);z-index:20;overflow:auto;padding:30px 12px}
.modal{background:#fff;max-width:560px;margin:0 auto;border-radius:8px;padding:18px}
.modal h3{margin-bottom:12px}
.modal .row{margin-bottom:10px}
#toast{position:fixed;right:16px;bottom:16px;background:var(--ink);color:#fff;padding:10px 16px;border-radius:6px;display:none;z-index:30;max-width:340px}
#toast.err{background:var(--bad)}
.tot{max-width:320px;margin-left:auto}
.tot div{display:flex;justify-content:space-between;padding:4px 0}
.tot .g{font-size:18px;font-weight:700;border-top:2px solid var(--ink);margin-top:4px;padding-top:6px}
.pw{position:relative}.pw input{padding-right:40px}
.eye{position:absolute;right:2px;top:2px;bottom:2px;width:34px;border:0;background:transparent;font-size:16px;opacity:.5;padding:0}
.eye.on{opacity:1}
.tabs{display:flex;gap:4px;margin:12px 0 16px;border-bottom:1px solid var(--line)}
.tabs a{padding:8px 12px;cursor:pointer;color:var(--mut);border-bottom:2px solid transparent;margin-bottom:-1px}
.tabs a.on{color:var(--ink);border-bottom-color:var(--acc);font-weight:600}
.link{color:var(--acc);cursor:pointer;font-size:13px}
.edgrid{display:grid;grid-template-columns:minmax(300px,430px) 1fr;gap:14px;align-items:start}
.chk{display:flex;gap:8px;align-items:center;margin:5px 0;color:var(--ink);font-size:14px}.chk input{width:auto}
.pgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
@media(max-width:1000px){.edgrid{grid-template-columns:1fr}}
@media(max-width:760px){#side{position:static;width:auto}#side nav{display:flex;overflow:auto}#side a{white-space:nowrap;border-left:0;border-bottom:3px solid transparent}#side a.on{border-bottom-color:#5cc8e6}#main{margin:0;padding:12px}#app{display:none}}
</style>
</head>
<body>

<div id="login">
  <div class="lbox">
    <h1>Stock &amp; Invoice System</h1>
    <div class="tabs" id="tabs"><a id="t_in" class="on" onclick="lview('in')">Sign in</a><a id="t_up" onclick="lview('up')">Create account</a></div>

    <div id="v_in">
      <div class="f"><label>Username or email</label><input id="lu" autocomplete="username"></div>
      <div class="f"><label>Password</label><div class="pw"><input id="lp" type="password" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()"><button type="button" class="eye" onclick="eye('lp',this)" aria-label="Show or hide password">&#128065;</button></div></div>
      <button class="btn" style="width:100%" onclick="doLogin()">Sign in</button>
      <p style="margin:12px 0 0"><a class="link" onclick="lview('fp')">Forgot password?</a></p>
    </div>

    <div id="v_up" style="display:none">
      <div class="f"><label>Username</label><input id="su" autocomplete="username"></div>
      <div class="f"><label>Email</label><input id="se" type="email" autocomplete="email"></div>
      <div class="f"><label>Password (min 6 characters)</label><div class="pw"><input id="sp" type="password" autocomplete="new-password"><button type="button" class="eye" onclick="eye('sp',this)" aria-label="Show or hide password">&#128065;</button></div></div>
      <div class="f"><label>Confirm password</label><div class="pw"><input id="sp2" type="password" autocomplete="new-password" onkeydown="if(event.key==='Enter')doSignup()"><button type="button" class="eye" onclick="eye('sp2',this)" aria-label="Show or hide password">&#128065;</button></div></div>
      <button class="btn" style="width:100%" onclick="doSignup()">Create account</button>
      <p style="margin:12px 0 0;font-size:12.5px">New accounts can sign in after an admin approves them.</p>
    </div>

    <div id="v_fp" style="display:none">
      <h3 style="margin-bottom:6px">Reset password</h3>
      <p>Enter your email or username. We will send a link to set a new password.</p>
      <div class="f"><label>Email or username</label><input id="fe" onkeydown="if(event.key==='Enter')doForgot()"></div>
      <button class="btn" style="width:100%" onclick="doForgot()">Send reset link</button>
      <p style="margin:12px 0 0"><a class="link" onclick="lview('in')">Back to sign in</a></p>
    </div>

    <div id="v_rp" style="display:none">
      <h3 style="margin-bottom:6px">Set a new password</h3>
      <div class="f"><label>New password (min 6 characters)</label><div class="pw"><input id="rp1" type="password" autocomplete="new-password"><button type="button" class="eye" onclick="eye('rp1',this)" aria-label="Show or hide password">&#128065;</button></div></div>
      <div class="f"><label>Confirm new password</label><div class="pw"><input id="rp2" type="password" autocomplete="new-password" onkeydown="if(event.key==='Enter')doReset()"><button type="button" class="eye" onclick="eye('rp2',this)" aria-label="Show or hide password">&#128065;</button></div></div>
      <button class="btn" style="width:100%" onclick="doReset()">Save new password</button>
    </div>

    <p id="lmsg" style="color:var(--bad);margin:12px 0 0"></p>
  </div>
</div>

<div id="app">
  <aside id="side">
    <div class="brand"><span id="coName">Company</span><small>Stock &amp; Invoice</small></div>
    <nav id="nav"></nav>
    <div class="me"><div id="meName"></div><a onclick="pwModal()" style="padding:4px 0;cursor:pointer;color:#fff;border:0">Change password</a><a onclick="logout()" style="padding:4px 0;cursor:pointer;color:#fff;border:0">Sign out</a></div>
  </aside>
  <main id="main"></main>
</div>

<div id="modalBg"><div class="modal" id="modal"></div></div>
<div id="toast"></div>

<script>
/* ===================== CONFIG: paste your Supabase values ===================== */
const CFG = { url: 'https://ybevwcxgfnwfyadgbfdl.supabase.co', key: 'sb_publishable_n0qwxibzfTZ8NQFw08jbjg_9mBL7IAh' };
const EMAIL_DOMAIN = '@laptopcare.app';   // usernames are stored as username@laptopcare.app
/* ============================================================================== */

const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money = n => Number(n || 0).toLocaleString('en-LK', {minimumFractionDigits:2, maximumFractionDigits:2});
const today = () => new Date().toISOString().slice(0,10);
let sb, me, items = [], settings = {};
const isAdmin = () => me && me.role === 'admin';
const hasP = k => isAdmin() || (me && (me.perms || []).includes(k));
const PERMS=[['invoice','Create invoice'],['invoices','View / reprint invoices'],['stock','Stock check'],['serial','Serial number check'],['grn','GRN (goods received)'],['items','Add / edit items'],['cost','See cost prices'],['price','Change price on invoice']];
const DEF_PERMS=['invoice','invoices'];
const permBoxes=(pre,sel)=>PERMS.map(([k,l])=>`<label class="chk"><input type="checkbox" id="${pre}_${k}" ${sel.includes(k)?'checked':''}> ${l}</label>`).join('');
const permRead=pre=>PERMS.filter(([k])=>$('#'+pre+'_'+k).checked).map(([k])=>k);

function toast(msg, err){const t=$('#toast');t.textContent=msg;t.className=err?'err':'';t.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>t.style.display='none',err?6000:2500)}
function openModal(html){$('#modal').innerHTML=html;$('#modalBg').style.display='block'}
function closeModal(){$('#modalBg').style.display='none'}
function addMonths(d,m){const x=new Date(d);x.setMonth(x.getMonth()+Number(m||0));return x.toISOString().slice(0,10)}
async function run(p){const r=await p;if(r.error){toast(r.error.message,true);throw r.error}return r.data}

/* ---------------- Auth ---------------- */
const RECOVERY = location.hash.includes('type=recovery');
let recovering = RECOVERY;
function msg(t,ok){const m=$('#lmsg');m.textContent=t||'';m.style.color=ok?'var(--ok)':'var(--bad)'}
function lview(v){
  ['in','up','fp','rp'].forEach(x=>{$('#v_'+x).style.display=x===v?'block':'none'});
  $('#tabs').style.display=(v==='in'||v==='up')?'flex':'none';
  $('#t_in').classList.toggle('on',v!=='up');$('#t_up').classList.toggle('on',v==='up');msg('');
}
function eye(id,b){const i=$('#'+id),show=i.type==='password';i.type=show?'text':'password';b.classList.toggle('on',show)}
function pwf(id,label){return `<div class="row"><label>${label}</label><div class="pw"><input id="${id}" type="password" autocomplete="new-password"><button type="button" class="eye" onclick="eye('${id}',this)" aria-label="Show or hide password">&#128065;</button></div></div>`}
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
async function emailFor(u){const {data}=await sb.rpc('email_for_username',{u});return data||null}

if (CFG.url.startsWith('YOUR')) {
  msg('Setup needed: put your Supabase URL and key at the top of index.html.');
} else {
  sb = supabase.createClient(CFG.url, CFG.key);
  sb.auth.onAuthStateChange(ev => { if (ev === 'PASSWORD_RECOVERY') { recovering = true; lview('rp'); } });
  if (RECOVERY) lview('rp');
  sb.auth.getSession().then(({data}) => { if (data.session && !recovering) afterLogin(data.session.user.id); });
}

async function doLogin(){
  const u=$('#lu').value.trim().toLowerCase(), p=$('#lp').value;
  msg('');
  if(!sb||!u||!p)return;
  let email=u;
  if(!u.includes('@')) email=(await emailFor(u))||(u+EMAIL_DOMAIN);
  const {data,error}=await sb.auth.signInWithPassword({email,password:p});
  if(error){msg(error.message==='Invalid login credentials'?'Wrong username or password.':'Login error: '+error.message);console.error(error);return}
  afterLogin(data.user.id);
}

async function doSignup(){
  const u=$('#su').value.trim().toLowerCase().replace(/[^a-z0-9._-]/g,''), em=$('#se').value.trim().toLowerCase(), p=$('#sp').value, p2=$('#sp2').value;
  if(!u)return msg('Enter a username (letters, numbers, . _ -)');
  if(!em.includes('@'))return msg('Enter a valid email');
  if(p.length<6)return msg('Password must be at least 6 characters');
  if(p!==p2)return msg('Passwords do not match');
  if(await emailFor(u))return msg('That username is already taken');
  const {error}=await sb.auth.signUp({email:em,password:p,options:{data:{username:u}}});
  if(error)return msg(error.message);
  await sb.auth.signOut();
  lview('in');msg('Account created. You can sign in after an admin approves it.',true);
}

async function doForgot(){
  let em=$('#fe').value.trim().toLowerCase();
  if(!em)return msg('Enter your email or username');
  if(!em.includes('@')){em=await emailFor(em);if(!em){lview('in');return msg('If that account exists, a reset link was sent.',true)}}
  const {error}=await sb.auth.resetPasswordForEmail(em,{redirectTo:location.origin+location.pathname});
  if(error)return msg(error.message);
  lview('in');msg('If that account exists, a reset link was sent. Check your inbox and spam folder.',true);
}

async function doReset(){
  const p=$('#rp1').value,p2=$('#rp2').value;
  if(p.length<6)return msg('Password must be at least 6 characters');
  if(p!==p2)return msg('Passwords do not match');
  const {error}=await sb.auth.updateUser({password:p});
  if(error)return msg(error.message);
  await sb.auth.signOut();recovering=false;history.replaceState(null,'',location.pathname);
  lview('in');msg('Password changed. Sign in with your new password.',true);
}

function pwModal(){
  openModal(`<h3>Change password</h3>${pwf('c1','New password (min 6 characters)')}${pwf('c2','Confirm new password')}
  <div class="bar" style="margin-top:14px;justify-content:flex-end"><div style="flex:0"><button class="btn sec" onclick="closeModal()">Cancel</button></div><div style="flex:0"><button class="btn" onclick="changePw()">Save</button></div></div>`);
}
async function changePw(){
  const p=$('#c1').value,p2=$('#c2').value;
  if(p.length<6)return toast('Password must be at least 6 characters',true);
  if(p!==p2)return toast('Passwords do not match',true);
  const {error}=await sb.auth.updateUser({password:p});
  if(error)return toast(error.message,true);
  closeModal();toast('Password changed');
}
async function afterLogin(uid){
  const {data:pr}=await sb.from('profiles').select('*').eq('id',uid).maybeSingle();
  if(!pr||!pr.active){await sb.auth.signOut();msg('Your account is waiting for admin approval, or it was disabled.');return}
  me=pr;
  const {data:st}=await sb.from('settings').select('*');
  settings={};(st||[]).forEach(r=>settings[r.key]=r.value);
  $('#coName').textContent=settings.company_name||'Company';
  $('#meName').textContent=me.username+' ('+me.role+')';
  $('#login').style.display='none';$('#app').style.display='block';
  const pages=[['dash','Dashboard']];
  [['stock','Stock check','stock'],['serial','Serial check','serial'],['invoice','New invoice','invoice'],['invoices','Invoices','invoices'],['items','Items','items'],['grn','GRN','grn']].forEach(([k,l,pm])=>{if(hasP(pm))pages.push([k,l])});
  if(isAdmin())pages.push(['users','Users'],['settings','Invoice editor']);
  $('#nav').innerHTML=pages.map(p=>`<a id="n_${p[0]}" onclick="go('${p[0]}')">${p[1]}</a>`).join('');
  go('dash');
}
async function logout(){await sb.auth.signOut();location.reload()}

const PAGES={};
async function go(p){
  const need={stock:'stock',serial:'serial',invoice:'invoice',invoices:'invoices',grn:'grn',items:'items'};
  if((need[p]&&!hasP(need[p]))||((p==='users'||p==='settings')&&!isAdmin()))p='dash';
  document.querySelectorAll('#nav a').forEach(a=>a.classList.remove('on'));
  const n=$('#n_'+p);if(n)n.classList.add('on');
  $('#main').innerHTML='<p class="mut">Loading…</p>';
  try{await PAGES[p]()}catch(e){console.error(e)}
}
async function loadItems(){items=await run(sb.from('stock_view').select('*').order('name'))}

/* ---------------- Dashboard ---------------- */
PAGES.dash=async()=>{
  const c=[];
  if(hasP('stock')||hasP('cost')){
    await loadItems();
    if(hasP('stock'))c.push([items.length,'Items'],[items.reduce((a,i)=>a+Number(i.in_stock),0),'Units in stock'],[items.filter(i=>i.in_stock<=0).length,'Items out of stock']);
    if(hasP('cost'))c.push(['Rs. '+money(items.reduce((a,i)=>a+Number(i.in_stock)*Number(i.cost),0)),'Stock value at cost']);
  }
  if(hasP('invoices')){
    const inv=await run(sb.from('invoices').select('total').eq('inv_date',today()));
    c.push(['Rs. '+money(inv.reduce((a,r)=>a+Number(r.total),0)),'Sales today ('+inv.length+' invoices)']);
  }
  const q=[['invoice','New invoice','btn'],['grn','New GRN','btn sec'],['stock','Stock check','btn sec'],['serial','Serial check','btn sec']].filter(x=>hasP(x[0]));
  $('#main').innerHTML=`<div class="top"><h2>Dashboard</h2></div>`+
   (c.length?`<div class="grid">${c.map(x=>`<div class="stat"><b>${x[0]}</b><span>${x[1]}</span></div>`).join('')}</div>`:'')+
   `<div class="card" style="margin-top:14px"><b>Quick actions</b><div class="bar" style="margin-top:10px">${q.map(x=>`<div style="flex:0"><button class="${x[2]}" onclick="go('${x[0]}')">${x[1]}</button></div>`).join('')||'<span class="mut">No tools are enabled for your account yet. Ask the admin.</span>'}</div></div>`;
};

/* ---------------- Stock check ---------------- */
PAGES.stock=async()=>{
  await loadItems();
  $('#main').innerHTML=`<div class="top"><h2>Stock check</h2></div>
  <div class="card"><input id="fq" placeholder="Filter items by code or name" oninput="stockTable()"></div>
  <div class="tw"><table><thead><tr><th>Code</th><th>Item</th><th class="r">In stock</th>${hasP('cost')?'<th class="r">Cost</th>':''}<th class="r">Selling price</th><th>Warranty</th></tr></thead><tbody id="stb"></tbody></table></div>`;
  stockTable();
};
function stockTable(){
  const q=($('#fq').value||'').toLowerCase();
  $('#stb').innerHTML=items.filter(i=>(i.name+' '+(i.code||'')).toLowerCase().includes(q)).map(i=>`<tr><td>${esc(i.code)}</td><td><b>${esc(i.name)}</b><div class="mut">${esc(i.description)}</div></td>
   <td class="r"><span class="tag ${i.in_stock>0?'ok':'bad'}">${i.in_stock}</span></td>${hasP('cost')?`<td class="r">${money(i.cost)}</td>`:''}<td class="r">${money(i.price)}</td><td>${i.warranty_months} mo</td></tr>`).join('')||'<tr><td colspan="6" class="mut">No items.</td></tr>';
}
/* ---------------- Serial number check ---------------- */
PAGES.serial=async()=>{
  $('#main').innerHTML=`<div class="top"><h2>Serial number check</h2></div>
  <div class="card"><label>Search a serial number (in stock or sold, who bought it, warranty)</label>
   <div class="bar"><div><input id="sq" placeholder="Serial number" onkeydown="if(event.key==='Enter')serialSearch()"></div><div style="flex:0"><button class="btn" onclick="serialSearch()">Search</button></div></div>
   <div id="sres" style="margin-top:10px"></div></div>`;
  $('#sq').focus();
};
async function serialSearch(){
  const q=$('#sq').value.trim();if(!q)return;
  const d=await run(sb.from('serials').select('*, items(name,code), invoices(inv_no,customer_name,inv_date)').ilike('serial','%'+q+'%').limit(30));
  $('#sres').innerHTML=d.length?`<div class="tw"><table><thead><tr><th>Serial</th><th>Item</th><th>Status</th><th>Sold to</th><th>Warranty until</th></tr></thead><tbody>${d.map(s=>`<tr><td>${esc(s.serial)}</td><td>${esc(s.items?.name)}</td>
   <td><span class="tag ${s.status==='in_stock'?'ok':'warn'}">${s.status==='in_stock'?'In stock':'Sold'}</span></td>
   <td>${s.invoices?esc(s.invoices.inv_no+' · '+(s.invoices.customer_name||'')+' · '+s.invoices.inv_date):'-'}</td>
   <td>${s.status==='sold'&&s.sold_at?addMonths(s.sold_at,s.warranty_months):'-'}</td></tr>`).join('')}</tbody></table></div>`:'<span class="mut">No serial found.</span>';
}

/* ---------------- Items ---------------- */
let G=[],CATS=[];
async function loadCats(){CATS=await run(sb.from('categories').select('*').order('name'))}
PAGES.items=async()=>{
  await Promise.all([loadItems(),loadCats()]);
  $('#main').innerHTML=`<div class="top"><h2>Items</h2><div class="bar"><div style="flex:0"><button class="btn sec" onclick="catModal()">Categories</button></div><div style="flex:0"><button class="btn" onclick="itemModal()">Add item</button></div></div></div>
  <div class="tw"><table><thead><tr><th>Code</th><th>Item</th><th>Category</th><th>Type</th><th class="r">Cost</th><th class="r">Price</th><th>Warranty</th><th></th></tr></thead><tbody>
  ${items.map(i=>`<tr><td>${esc(i.code)}</td><td><b>${esc(i.name)}</b><div class="mut" style="white-space:pre-line">${esc(i.description)}</div></td><td>${esc(i.category_name)}</td><td>${i.track_serial?'Serial':'Qty only'}</td><td class="r">${money(i.cost)}</td><td class="r">${money(i.price)}</td><td>${i.warranty_months} mo</td>
  <td><button class="btn sec sm" onclick="itemModal(${i.id})">Edit</button></td></tr>`).join('')||'<tr><td colspan="8" class="mut">No items yet.</td></tr>'}</tbody></table></div>`;
};
function itemModal(id,after){
  const i=items.find(x=>x.id===id)||{track_serial:true,warranty_months:0,cost:0,price:0};
  window._itemAfter=after;
  openModal(`<h3>${id?'Edit':'New'} item</h3>
  <div class="bar"><div><label>Category</label><select id="i_cat"><option value="">- none -</option>${CATS.map(c=>`<option value="${c.id}" ${c.id==i.category_id?'selected':''}>${esc(c.name)}</option>`).join('')}</select></div>
   <div><label>Code ${id?'':'(leave empty = auto from category)'}</label><input id="i_code" value="${esc(i.code)}"></div></div>
  <div class="row" style="margin-top:8px"><label>Item name</label><input id="i_name" value="${esc(i.name)}"></div>
  <div class="row"><label>Description / specs (printed on invoice, one detail per line)</label><textarea id="i_desc" rows="3">${esc(i.description)}</textarea></div>
  <div class="row"><label>Tracking</label><select id="i_ts"><option value="1" ${i.track_serial?'selected':''}>Serial number per unit</option><option value="0" ${!i.track_serial?'selected':''}>Quantity only (no serials)</option></select></div>
  <div class="bar"><div><label>Default warranty (months)</label><input id="i_w" type="number" min="0" value="${i.warranty_months}"></div><div><label>Cost</label><input id="i_c" type="number" step="0.01" value="${i.cost}"></div><div><label>Selling price</label><input id="i_p" type="number" step="0.01" value="${i.price}"></div></div>
  <div class="bar" style="margin-top:14px;justify-content:flex-end"><div style="flex:0"><button class="btn sec" onclick="closeModal()">Cancel</button></div><div style="flex:0"><button class="btn" onclick="saveItem(${id||0})">Save</button></div></div>`);
}
async function saveItem(id){
  const row={code:$('#i_code').value.trim()||null,name:$('#i_name').value.trim(),description:$('#i_desc').value.trim(),track_serial:$('#i_ts').value==='1',category_id:+$('#i_cat').value||null,
    warranty_months:+$('#i_w').value||0,cost:+$('#i_c').value||0,price:+$('#i_p').value||0};
  if(!row.name)return toast('Item name is required',true);
  if(id){if(!row.code)delete row.code;await run(sb.from('items').update(row).eq('id',id))}else await run(sb.from('items').insert(row));
  closeModal();toast('Item saved');
  if(window._itemAfter){await window._itemAfter()}else go('items');
}
function catModal(){
  openModal(`<h3>Categories</h3><div class="tw"><table><thead><tr><th>Name</th><th>Code prefix</th><th>Next code</th></tr></thead><tbody>${CATS.map(c=>`<tr><td>${esc(c.name)}</td><td>${esc(c.prefix)}</td><td>${esc(c.prefix)}-${String(c.next_no).padStart(4,'0')}</td></tr>`).join('')}</tbody></table></div>
  <div class="bar" style="margin-top:12px"><div><label>New category</label><input id="c_n"></div><div><label>Code prefix (e.g. MOU)</label><input id="c_p" maxlength="5"></div><div style="flex:0"><button class="btn" onclick="saveCat()">Add</button></div></div>
  <div style="margin-top:12px;text-align:right"><button class="btn sec" onclick="closeModal()">Close</button></div>`);
}
async function saveCat(){
  const name=$('#c_n').value.trim(),prefix=$('#c_p').value.trim().toUpperCase().replace(/[^A-Z0-9]/g,'');
  if(!name||!prefix)return toast('Enter a name and a code prefix',true);
  await run(sb.from('categories').insert({name,prefix}));await loadCats();toast('Category added');catModal();
  if($('#gl'))grnRender();
}

/* ---------------- GRN ---------------- */
PAGES.grn=async()=>{
  await Promise.all([loadItems(),loadCats()]);G=[];
  const list=await run(sb.from('grn').select('*').order('id',{ascending:false}).limit(30));
  $('#main').innerHTML=`<div class="top"><h2>Goods received note (GRN)</h2>${hasP('items')?'<button class="btn sec" onclick="catModal()">Categories</button>':''}</div>
  <div class="card"><div class="bar">
    <div><label>Date</label><input id="g_date" type="date" value="${today()}"></div>
    <div><label>Supplier</label><input id="g_sup"></div>
    <div><label>Supplier invoice / ref no</label><input id="g_ref"></div>
    <div><label>Note</label><input id="g_note"></div></div></div>
  <div id="gl"></div>
  <div class="bar" style="margin-bottom:14px"><div style="flex:0"><button class="btn sec" onclick="grnAdd()">+ Add line</button></div>
   <div style="text-align:right"><b id="gt"></b></div><div style="flex:0"><button class="btn" onclick="grnSave()">Save GRN</button></div></div>
  <h3 style="margin:18px 0 8px">Recent GRNs</h3>
  <div class="tw"><table><thead><tr><th>GRN</th><th>Date</th><th>Supplier</th><th>Ref</th><th class="r">Total cost</th></tr></thead><tbody>
  ${list.map(g=>`<tr><td>${esc(g.grn_no)}</td><td>${g.grn_date}</td><td>${esc(g.supplier)}</td><td>${esc(g.ref_no)}</td><td class="r">${money(g.total)}</td></tr>`).join('')||'<tr><td colspan="5" class="mut">None yet.</td></tr>'}</tbody></table></div>`;
  grnAdd();
};
function grnAdd(){G.push({cat:'',item_id:'',isNew:false,nw:{name:'',ts:true},qty:1,cost:'',price:'',w:'',details:'',serials:[]});grnRender()}
function grnDel(i){G.splice(i,1);grnRender()}
function grnCat(i,v){G[i].cat=v;G[i].item_id='';G[i].isNew=false;grnRender()}
function grnItem(i,v){
  const l=G[i];
  if(v==='__new'){l.isNew=true;l.item_id=''}
  else{l.isNew=false;l.item_id=v;const it=items.find(x=>x.id==v);if(it){l.cost=it.cost;l.price=it.price;l.w=it.warranty_months;l.details=it.description||''}}
  grnRender();
}
function grnCode(i){
  const c=CATS.find(x=>x.id==G[i].cat);if(!c)return 'Choose a category first';
  let n=c.next_no;for(let j=0;j<i;j++)if(G[j].isNew&&G[j].cat==G[i].cat)n++;
  return c.prefix+'-'+String(n).padStart(4,'0');
}
function grnTracks(l){if(l.isNew)return l.nw.ts;const it=items.find(x=>x.id==l.item_id);return it?it.track_serial:true}
function srHtml(i){
  const l=G[i];
  return Array.from({length:l.qty},(_,k)=>`<input id="s_${i}_${k}" placeholder="Serial ${k+1}" value="${esc(l.serials[k]||'')}" oninput="G[${i}].serials[${k}]=this.value" onkeydown="srKey(event,${i},${k})" onpaste="srPaste(event,${i},${k})">`).join('');
}
function srKey(e,i,k){if(e.key==='Enter'){e.preventDefault();const nx=$('#s_'+i+'_'+(k+1));if(nx)nx.focus()}}
function srPaste(e,i,k){
  const t=(e.clipboardData||window.clipboardData).getData('text');
  const parts=t.split(/[\n\r,;\t]+/).map(x=>x.trim()).filter(Boolean);
  if(parts.length<2)return;
  e.preventDefault();
  const l=G[i];l.qty=Math.min(500,Math.max(l.qty,k+parts.length));
  parts.forEach((x,j)=>{l.serials[k+j]=x});grnRender();
}
function grnQty(i,v){
  const n=Math.min(500,Math.max(1,parseInt(v)||1));G[i].qty=n;if(G[i].serials.length>n)G[i].serials.length=n;
  const sr=$('#sr'+i);if(sr)sr.innerHTML=srHtml(i);const sc=$('#sc'+i);if(sc)sc.textContent=n;grnTotal();
}
function grnRender(){
  $('#gl').innerHTML=G.map((l,i)=>{
    const ts=grnTracks(l),list=items.filter(x=>!l.cat||x.category_id==l.cat);
    return `<div class="line"><div class="bar">
     <div><label>Category</label><select onchange="grnCat(${i},this.value)"><option value="">- all / none -</option>${CATS.map(c=>`<option value="${c.id}" ${c.id==l.cat?'selected':''}>${esc(c.name)}</option>`).join('')}</select></div>
     <div style="flex:2"><label>Item</label><select onchange="grnItem(${i},this.value)"><option value="">Select item…</option><option value="__new" ${l.isNew?'selected':''}>+ New item</option>${list.map(x=>`<option value="${x.id}" ${x.id==l.item_id&&!l.isNew?'selected':''}>${esc((x.code?x.code+' - ':'')+x.name)}</option>`).join('')}</select></div>
     <div style="flex:0"><button class="btn sec sm" onclick="grnDel(${i})">Remove</button></div></div>
     ${l.isNew?`<div class="bar" style="margin-top:8px"><div style="flex:2"><label>New item name</label><input value="${esc(l.nw.name)}" oninput="G[${i}].nw.name=this.value"></div>
       <div><label>Tracking</label><select onchange="G[${i}].nw.ts=this.value==='1';grnRender()"><option value="1" ${l.nw.ts?'selected':''}>Serial number per unit</option><option value="0" ${!l.nw.ts?'selected':''}>Quantity only</option></select></div>
       <div><label>Auto code</label><input readonly value="${esc(grnCode(i))}"></div></div>`:''}
     <div class="bar" style="margin-top:8px">
      <div><label>Quantity</label><input type="number" min="1" max="500" value="${l.qty}" oninput="grnQty(${i},this.value)"></div>
      <div><label>Cost (each)</label><input type="number" step="0.01" value="${l.cost}" oninput="G[${i}].cost=this.value;grnTotal()"></div>
      <div><label>Selling price</label><input type="number" step="0.01" value="${l.price}" oninput="G[${i}].price=this.value"></div>
      <div><label>Warranty (months)</label><input type="number" min="0" value="${l.w}" oninput="G[${i}].w=this.value"></div></div>
     <div style="margin-top:8px"><label>Description / specs (printed on the invoice, one detail per line)</label><textarea rows="3" oninput="G[${i}].details=this.value">${esc(l.details)}</textarea></div>
     ${ts?`<div style="margin-top:8px"><label>Serial numbers: <b id="sc${i}">${l.qty}</b> needed. Type or scan one by one, press Enter for the next box.</label>
       <div id="sr${i}" style="display:grid;gap:6px;grid-template-columns:repeat(auto-fill,minmax(210px,1fr))">${srHtml(i)}</div></div>`:''}</div>`}).join('');
  grnTotal();
}
function grnTotal(){$('#gt').textContent='Total cost: Rs. '+money(G.reduce((a,l)=>a+(+l.qty||0)*(+l.cost||0),0))}
async function grnSave(){
  const lines=[];
  for(let i=0;i<G.length;i++){
    const l=G[i],ts=grnTracks(l);
    let nm='';
    if(l.isNew){nm=l.nw.name.trim();if(!nm)return toast('Enter the new item name on line '+(i+1),true)}
    else{const it=items.find(x=>x.id==l.item_id);if(!it)return toast('Select an item on line '+(i+1),true);nm=it.name}
    if(l.cost===''||l.price==='')return toast('Enter cost and selling price for '+nm,true);
    let serials=[];
    if(ts){
      serials=Array.from({length:l.qty},(_,k)=>String(l.serials[k]||'').trim());
      if(serials.some(x=>!x))return toast('Fill all '+l.qty+' serial numbers for '+nm,true);
      if(new Set(serials).size!==serials.length)return toast('Duplicate serial number on line '+(i+1),true);
    }
    lines.push({item_id:l.isNew?null:+l.item_id,new_item:l.isNew?{name:nm,category_id:l.cat||'',track_serial:l.nw.ts}:null,qty:l.qty,cost:+l.cost,price:+l.price,warranty_months:+l.w||0,details:l.details.trim(),serials});
  }
  if(!lines.length)return toast('Add at least one line',true);
  await run(sb.rpc('create_grn',{p:{grn_date:$('#g_date').value,supplier:$('#g_sup').value,ref_no:$('#g_ref').value,note:$('#g_note').value,lines}}));
  toast('GRN saved');go('grn');
}

/* ---------------- New invoice ---------------- */
let L=[];
PAGES.invoice=async()=>{
  await loadItems();L=[];
  $('#main').innerHTML=`<div class="top"><h2>New invoice</h2></div>
  <div class="card"><div class="bar">
   <div><label>Date</label><input id="v_date" type="date" value="${today()}"></div>
   <div style="flex:2"><label>Customer name</label><input id="v_cn"></div>
   <div><label>Phone</label><input id="v_ph"></div>
   <div style="flex:2"><label>Address</label><input id="v_ad"></div></div></div>
  <div class="card"><b>Add item</b><div class="bar" style="margin-top:8px">
   <div style="flex:2"><label>Item</label><select id="a_item" onchange="invPick()"><option value="">Select item…</option>${items.filter(i=>i.in_stock>0).map(i=>`<option value="${i.id}">${esc((i.code?i.code+' - ':'')+i.name)}${hasP('stock')?' ('+i.in_stock+')':''}</option>`).join('')}</select></div>
   <div id="a_ser" style="flex:2;display:none"><label>Serial number (type / scan / choose)</label><input id="a_sn" list="a_dl" onkeydown="if(event.key==='Enter')invAdd()"><datalist id="a_dl"></datalist></div>
   <div id="a_qtyw" style="display:none"><label>Qty</label><input id="a_qty" type="number" min="1" value="1"></div>
   <div><label>Price</label><input id="a_pr" type="number" step="0.01" ${hasP('price')?'':'readonly'}></div>
   <div style="flex:0"><button class="btn" onclick="invAdd()">Add</button></div></div>
   <div class="mut" style="margin-top:6px">Tip: you can scan or type a serial number straight into the serial box and press Enter.</div></div>
  <div class="tw"><table><thead><tr><th>#</th><th>Description</th><th>Serial</th><th>Warranty</th><th class="r">Qty</th><th class="r">Price</th><th class="r">Amount</th><th></th></tr></thead><tbody id="vl"></tbody></table></div>
  <div class="card" style="margin-top:14px"><div class="bar">
   <div><label>Payment method</label><select id="v_pm"><option>Cash</option><option>Card</option><option>Bank transfer</option><option>Cheque</option><option>Credit</option></select></div>
   <div style="flex:2"><label>Note</label><input id="v_nt"></div>
   <div><label>Discount</label><input id="v_dc" type="number" step="0.01" value="0" oninput="invTotals()"></div></div>
   <div class="tot" id="vt" style="margin-top:12px"></div></div>
  <div class="bar" style="justify-content:flex-end"><div style="flex:0"><label>Print format</label><select id="v_fmt">${fmtOptions()}</select></div><div style="flex:0"><button class="btn" onclick="invSave()">Save &amp; print</button></div></div>`;
  invRender();
};
function fmtOptions(){const cur=localStorage.getItem('fmt')||getLY().fmt||'a4';return [['a4','A4'],['a5','A5'],['th80','Thermal 80mm'],['dotf','Dot matrix - full page (9.5x11in)'],['doth','Dot matrix - half page (9.5x5.5in)']].map(f=>`<option value="${f[0]}" ${f[0]===cur?'selected':''}>${f[1]}</option>`).join('')}
async function invPick(){
  const it=items.find(x=>x.id==$('#a_item').value);
  $('#a_ser').style.display=it&&it.track_serial?'block':'none';
  $('#a_qtyw').style.display=it&&!it.track_serial?'block':'none';
  $('#a_pr').value=it?it.price:'';$('#a_sn').value='';
  if(it&&it.track_serial){
    const d=await run(sb.from('serials').select('serial').eq('item_id',it.id).eq('status','in_stock').order('serial').limit(300));
    $('#a_dl').innerHTML=d.map(s=>`<option value="${esc(s.serial)}">`).join('');
  }
}
async function invAdd(){
  let it=items.find(x=>x.id==$('#a_item').value);
  const sn=$('#a_sn').value.trim();
  if(!it&&sn){ // scan straight from serial
    const d=await run(sb.from('serials').select('*').eq('serial',sn).eq('status','in_stock').maybeSingle());
    if(!d)return toast('Serial not in stock',true);
    it=items.find(x=>x.id==d.item_id);
    if(L.some(l=>l.serial===sn))return toast('Already added',true);
    L.push({item_id:it.id,description:it.name,details:d.details||it.description||'',serial:sn,qty:1,price:d.price||it.price,w:d.warranty_months});
    $('#a_sn').value='';return invRender();
  }
  if(!it)return toast('Select an item',true);
  const price=+$('#a_pr').value;
  if(it.track_serial){
    if(!sn)return toast('Enter the serial number',true);
    if(L.some(l=>l.serial===sn))return toast('Already added',true);
    const d=await run(sb.from('serials').select('*').eq('serial',sn).eq('item_id',it.id).eq('status','in_stock').maybeSingle());
    if(!d)return toast('That serial is not in stock for this item',true);
    L.push({item_id:it.id,description:it.name,details:d.details||it.description||'',serial:sn,qty:1,price:hasP('price')?price:(d.price||it.price),w:d.warranty_months});
    $('#a_sn').value='';
  }else{
    const q=+$('#a_qty').value||1;
    const have=L.filter(l=>l.item_id===it.id).reduce((a,l)=>a+l.qty,0);
    if(have+q>it.in_stock)return toast('Only '+it.in_stock+' in stock',true);
    L.push({item_id:it.id,description:it.name,details:it.description||'',serial:null,qty:q,price:hasP('price')?price:it.price,w:it.warranty_months});
  }
  invRender();
}
function invRender(){
  $('#vl').innerHTML=L.map((l,i)=>`<tr><td>${i+1}</td><td><b>${esc(l.description)}</b><div class="mut" style="white-space:pre-line">${esc(l.details)}</div></td><td>${esc(l.serial)}</td><td>${l.w} mo</td><td class="r">${l.qty}</td><td class="r">${money(l.price)}</td><td class="r">${money(l.qty*l.price)}</td><td><button class="btn sec sm" onclick="L.splice(${i},1);invRender()">x</button></td></tr>`).join('')||'<tr><td colspan="8" class="mut">No items added.</td></tr>';
  invTotals();
}
function invTotals(){
  const s=L.reduce((a,l)=>a+l.qty*l.price,0),d=+($('#v_dc')||{}).value||0;
  $('#vt').innerHTML=`<div><span>Subtotal</span><span>${money(s)}</span></div><div><span>Discount</span><span>${money(d)}</span></div><div class="g"><span>Total (Rs.)</span><span>${money(s-d)}</span></div>`;
}
async function invSave(){
  if(!L.length)return toast('Add at least one item',true);
  const fmt=$('#v_fmt').value;localStorage.setItem('fmt',fmt);
  const id=await run(sb.rpc('create_invoice',{p:{inv_date:$('#v_date').value,customer_name:$('#v_cn').value,phone:$('#v_ph').value,address:$('#v_ad').value,pay_method:$('#v_pm').value,note:$('#v_nt').value,discount:+$('#v_dc').value||0,
    lines:L.map(l=>({item_id:l.item_id,description:l.description,details:l.details,serial:l.serial,qty:l.qty,unit_price:l.price,warranty_months:l.w}))}}));
  toast('Invoice saved');
  await printInvoice(id,fmt);
  go(hasP('invoices')?'invoices':'invoice');
}

/* ---------------- Invoice list ---------------- */
PAGES.invoices=async()=>{
  const d=await run(sb.from('invoices').select('*').order('id',{ascending:false}).limit(100));
  $('#main').innerHTML=`<div class="top"><h2>Invoices</h2><div style="width:220px"><label>Reprint format</label><select id="p_fmt">${fmtOptions()}</select></div></div>
  <div class="tw"><table><thead><tr><th>Invoice</th><th>Date</th><th>Customer</th><th>Payment</th><th class="r">Total</th><th></th></tr></thead><tbody>
  ${d.map(v=>`<tr><td>${esc(v.inv_no)}</td><td>${v.inv_date}</td><td>${esc(v.customer_name)}<div class="mut">${esc(v.phone)}</div></td><td>${esc(v.pay_method)}</td><td class="r">${money(v.total)}</td>
   <td style="white-space:nowrap"><button class="btn sec sm" onclick="printInvoice(${v.id},$('#p_fmt').value)">Print</button> ${isAdmin()?`<button class="btn sec sm" onclick="voidInv(${v.id},'${esc(v.inv_no)}')">Delete</button>`:''}</td></tr>`).join('')||'<tr><td colspan="6" class="mut">No invoices yet.</td></tr>'}</tbody></table></div>`;
};
async function voidInv(id,no){
  if(!confirm('Delete '+no+'? Serials and stock will be returned to stock.'))return;
  await run(sb.rpc('void_invoice',{inv:id}));toast('Invoice deleted');go('invoices');
}

/* ---------------- Printing ---------------- */
const LY_DEF={logo:'',logoH:70,align:'left',title:'INVOICE',titleSize:30,nameSize:24,email:'',web:'',showSerial:true,showWarranty:true,showUntil:true,termsTitle:'Warranty terms',terms:'',footer:'Thank you for your business.',showSig:true,sigL:'Prepared by',sigM:'',sigR:'Customer signature',fontSize:0,fmt:'a4',off:{}};
function getLY(){let o={};try{o=JSON.parse(settings.invoice_layout||'{}')}catch(e){}
  return {...LY_DEF,...o,footer:(o.footer!==undefined?o.footer:(settings.invoice_footer||LY_DEF.footer))}}
function coInfo(){return {n:settings.company_name||'Company',a:settings.company_addr||'',p:settings.company_phone||''}}

async function printInvoice(id,fmt){
  const inv=await run(sb.from('invoices').select('*').eq('id',id).single());
  const ln=await run(sb.from('invoice_items').select('*').eq('invoice_id',id).order('id'));
  const doc=invDoc(inv,ln,fmt,coInfo(),getLY(),false);
  const f=document.createElement('iframe');f.style.cssText='position:fixed;right:0;bottom:0;width:0;height:0;border:0';document.body.appendChild(f);
  f.contentDocument.open();f.contentDocument.write(doc);f.contentDocument.close();
  setTimeout(()=>{f.contentWindow.focus();f.contentWindow.print();setTimeout(()=>f.remove(),60000)},400);
}

function invDoc(inv,ln,fmt,co,ly,pv){
  let html,css,extra='';
  if(fmt==='dotf'||fmt==='doth'){
    html='<pre>'+esc(dotText(inv,ln,co,ly,fmt==='dotf'))+'</pre>';
    css=`@page{size:9.5in ${fmt==='dotf'?'11in':'5.5in'};margin:.2in .3in}body{margin:0;${pv?'padding:12px;':''}}pre{font:12pt/1.2 "Courier New",monospace;margin:0}`;
  }else{
    const th=fmt==='th80',a5=fmt==='a5',fs=+ly.fontSize||(th||a5?11:13),size={a4:'A4',a5:'A5',th80:'80mm auto'}[fmt]||'A4',center=th||ly.align==='center';
    const nameSz=th?Math.min(ly.nameSize,16):ly.nameSize,titleSz=th?Math.min(ly.titleSize,16):ly.titleSize;
    const bk=(n,inner)=>{const o=(ly.off||{})[n];return `<div class="bk" data-b="${n}"${o&&(o[0]||o[1])?` style="position:relative;left:${o[0]}px;top:${o[1]}px"`:''}>${inner}</div>`};
    const logo=ly.logo?bk('logo',`<img src="${ly.logo}" style="height:${th?Math.min(ly.logoH,50):ly.logoH}px;max-width:100%;display:block${center?';margin:0 auto 4px':''}">`):'';
    const line=x=>x?`<div>${esc(x)}</div>`:'';
    const comp=bk('company',`<div class="nm">${esc(co.n)}</div>${String(co.a||'').split('\n').filter(Boolean).map(line).join('')}${line(co.p)}${line(ly.email)}${line(ly.web)}`);
    const meta=bk('title',`<div class="ti">${esc(ly.title)}</div><div>${esc(inv.inv_no)}</div><div>${inv.inv_date}</div>`);
    const head=center?`<div class="c">${logo}${comp}${meta}</div>`:`<div class="hd"><div class="co">${logo}${comp}</div><div style="text-align:right">${meta}</div></div>`;
    const wcell=l=>l.warranty_months?l.warranty_months+' months'+(ly.showUntil?'<div>until '+addMonths(inv.inv_date,l.warranty_months)+'</div>':''):'-';
    const showW=ly.showWarranty&&!th;
    const rows=ln.map((l,i)=>`<tr>${th?'':`<td>${i+1}</td>`}<td><b>${esc(l.description)}</b>${l.details?`<div class="dt">${esc(l.details).replace(/\n/g,'<br>')}</div>`:''}${ly.showSerial&&l.serial?`<div>S/N: ${esc(l.serial)}</div>`:''}${th&&ly.showWarranty&&l.warranty_months?`<div>Warranty: ${l.warranty_months} mo</div>`:''}</td>${showW?`<td>${wcell(l)}</td>`:''}<td class="r">${l.qty}</td><td class="r">${money(l.unit_price)}</td><td class="r">${money(l.amount)}</td></tr>`).join('');
    const terms=ly.terms?bk('terms',`<div class="terms"><b>${esc(ly.termsTitle)}</b><div>${esc(ly.terms).replace(/\n/g,'<br>')}</div></div>`):'';
    const labels=[ly.sigL,ly.sigM,ly.sigR].filter(Boolean);
    const sig=ly.showSig&&!th&&labels.length?bk('sig',`<div class="sg">${labels.map(x=>`<div>${esc(x)}</div>`).join('')}</div>`):'';
    css=`@page{size:${size};margin:${th?'3mm':'12mm'}}body{font:${fs}px/1.4 Arial,sans-serif;color:#000;margin:0;${th?'width:72mm;':''}${pv?'padding:16px;':''}}
    .nm{font-size:${nameSz}px;font-weight:700;line-height:1.2;margin-bottom:2px}.ti{font-size:${titleSz}px;font-weight:700;letter-spacing:1px;line-height:1.1}
    table{width:100%;border-collapse:collapse;margin-top:8px}th,td{padding:${th?'2px':'5px 6px'};border-bottom:1px solid #999;text-align:left;vertical-align:top}th{border-top:1px solid #000;border-bottom:1px solid #000}
    .dt{font-size:.88em;color:#333;margin:2px 0}.r{text-align:right}.hd{display:flex;justify-content:space-between;gap:12px;margin-bottom:8px}.co{display:flex;gap:14px;align-items:flex-start}.c{text-align:center;margin-bottom:6px}
    .tt{margin-left:auto;width:${th?'100%':'45%'};margin-top:8px}.tt div{display:flex;justify-content:space-between;padding:2px 0}.tt .g{font-weight:700;font-size:1.15em;border-top:2px solid #000}
    .terms{margin-top:12px;border:1px solid #999;padding:6px 8px;font-size:.9em}.sg{display:flex;justify-content:space-between;gap:20px;margin-top:44px}.sg div{border-top:1px solid #000;padding-top:3px;flex:1;text-align:center}
    ${pv?'.bk{cursor:move}.bk:hover{outline:1px dashed #0b6e8a;outline-offset:2px}':''}`;
    html=`${head}
      ${bk('customer',`<div style="margin-top:8px"><b>Customer:</b> ${esc(inv.customer_name)} ${esc(inv.phone)}<div>${esc(inv.address)}</div></div>`)}
      <table><thead><tr>${th?'':'<th>#</th>'}<th>Description</th>${showW?'<th>Warranty</th>':''}<th class="r">Qty</th><th class="r">Price</th><th class="r">Amount</th></tr></thead><tbody>${rows}</tbody></table>
      ${bk('totals',`<div class="tt"><div><span>Subtotal</span><span>${money(inv.subtotal)}</span></div>${+inv.discount?`<div><span>Discount</span><span>${money(inv.discount)}</span></div>`:''}<div class="g"><span>Total</span><span>Rs. ${money(inv.total)}</span></div><div><span>Payment</span><span>${esc(inv.pay_method)}</span></div></div>`)}
      ${terms}${bk('footer',`<p class="c" style="margin-top:14px">${esc(ly.footer)}</p>`)}${sig}`;
    if(pv)extra=`<script>(function(){var cur=null,sx,sy,ox,oy;document.addEventListener('mousedown',function(e){var b=e.target.closest('.bk');if(!b)return;cur=b;sx=e.clientX;sy=e.clientY;ox=parseFloat(b.style.left)||0;oy=parseFloat(b.style.top)||0;e.preventDefault()});document.addEventListener('mousemove',function(e){if(!cur)return;cur.style.position='relative';cur.style.left=(ox+e.clientX-sx)+'px';cur.style.top=(oy+e.clientY-sy)+'px'});document.addEventListener('mouseup',function(){if(!cur)return;parent.postMessage({edrag:cur.dataset.b,x:parseFloat(cur.style.left)||0,y:parseFloat(cur.style.top)||0},'*');cur=null})})();<\/script>`;
  }
  return `<html><head><meta charset="utf-8"><title>${esc(inv.inv_no)}</title><style>${css}</style></head><body>${html}${extra}</body></html>`;
}

function wrapTxt(t,w){const out=[];String(t||'').split('\n').forEach(par=>{let line='';par.split(' ').forEach(wd=>{if((line+' '+wd).trim().length>w){out.push(line);line=wd}else line=(line+' '+wd).trim()});out.push(line)});return out}
function dotText(inv,ln,co,ly,full){
  const W=80,p=(s,n)=>String(s??'').slice(0,n).padEnd(n),r=(s,n)=>String(s??'').slice(0,n).padStart(n),c=s=>' '.repeat(Math.max(0,(W-s.length)>>1))+s,bar='-'.repeat(W);
  let o=[c(co.n.toUpperCase()),...String(co.a||'').split('\n').filter(Boolean).map(x=>c(x)),c([co.p,ly.email,ly.web].filter(Boolean).join('  ')),bar,
    p(ly.title+': '+inv.inv_no,40)+r('Date: '+inv.inv_date,40),
    p('Customer: '+(inv.customer_name||''),W),p('Phone: '+(inv.phone||''),W),p('Address: '+(inv.address||''),W),bar,
    p('No',3)+' '+p('Description',40)+' '+r('Qty',4)+' '+r('Price',12)+' '+r('Amount',14),bar];
  ln.forEach((l,i)=>{
    o.push(p(i+1,3)+' '+p(l.description,40)+' '+r(l.qty,4)+' '+r(money(l.unit_price),12)+' '+r(money(l.amount),14));
    if(l.details)wrapTxt(l.details,70).forEach(x=>o.push('    '+x));
    const x=[];if(ly.showSerial&&l.serial)x.push('S/N: '+l.serial);
    if(ly.showWarranty&&l.warranty_months)x.push('Warranty: '+l.warranty_months+' mo'+(ly.showUntil?' (until '+addMonths(inv.inv_date,l.warranty_months)+')':''));
    if(x.length)o.push('    '+x.join('  '));
  });
  o.push(bar,r('Subtotal: '+money(inv.subtotal),W));
  if(+inv.discount)o.push(r('Discount: '+money(inv.discount),W));
  o.push(r('TOTAL Rs.: '+money(inv.total),W),r('Payment: '+(inv.pay_method||''),W),bar);
  if(ly.terms){o.push(ly.termsTitle+':');wrapTxt(ly.terms,W).forEach(x=>o.push(x));o.push(bar)}
  o.push(c(ly.footer));
  const labels=[ly.sigL,ly.sigM,ly.sigR].filter(Boolean);
  if(full&&ly.showSig&&labels.length){const cw=Math.floor(W/labels.length);o.push('','');o.push(labels.map(()=>p('_'.repeat(cw-4),cw)).join(''));o.push(labels.map(x=>p(x,cw)).join(''))}
  return o.join('\n');
}

/* ---------------- Users (admin) ---------------- */
let USERS=[];
PAGES.users=async()=>{
  USERS=await run(sb.from('profiles').select('*').order('created_at'));
  const pend=USERS.filter(u=>!u.active).length;
  const access=u=>u.role==='admin'?'Everything':((u.perms||[]).map(k=>(PERMS.find(x=>x[0]===k)||[k,k])[1]).join(', ')||'Nothing');
  $('#main').innerHTML=`<div class="top"><h2>Users</h2></div>
  ${pend?`<div class="card" style="border-color:var(--warn)"><b>${pend} account(s) pending or disabled.</b> Click Approve to let them sign in.</div>`:''}
  <div class="card"><b>Add user</b><div class="bar" style="margin-top:8px">
   <div><label>Username</label><input id="u_n"></div>
   <div><label>Email (optional)</label><input id="u_e" type="email"></div>
   <div><label>Password (min 6)</label><div class="pw"><input id="u_p" type="password" autocomplete="new-password"><button type="button" class="eye" onclick="eye('u_p',this)" aria-label="Show or hide password">&#128065;</button></div></div>
   <div><label>Role</label><select id="u_r"><option value="user">User (limited)</option><option value="admin">Admin (full control)</option></select></div></div>
   <div style="margin-top:10px"><label>What can this user do? (ignored for Admin)</label><div class="pgrid">${permBoxes('np',DEF_PERMS)}</div></div>
   <div style="margin-top:10px"><button class="btn" onclick="addUser()">Create user</button></div>
   <div class="mut" style="margin-top:6px">Added here = active straight away. Add a real email if they should be able to reset their own password.</div></div>
  <div class="tw"><table><thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Can do</th><th>Status</th><th></th></tr></thead><tbody>
  ${USERS.map(u=>`<tr><td>${esc(u.username)}</td><td>${esc(u.email)}</td><td><select onchange="setRole('${u.id}',this.value)" ${u.id===me.id?'disabled':''}><option value="user" ${u.role==='user'?'selected':''}>User</option><option value="admin" ${u.role==='admin'?'selected':''}>Admin</option></select></td>
   <td style="max-width:260px">${esc(access(u))}</td>
   <td><span class="tag ${u.active?'ok':'warn'}">${u.active?'Active':'Pending / disabled'}</span></td>
   <td style="white-space:nowrap">${u.role==='admin'?'':`<button class="btn sec sm" onclick="permModal('${u.id}')">Permissions</button> `}${u.id===me.id?'':`<button class="btn sec sm" onclick="setActive('${u.id}',${!u.active})">${u.active?'Disable':'Approve'}</button>`}</td></tr>`).join('')}</tbody></table></div>`;
};
function permModal(id){
  const u=USERS.find(x=>x.id===id);
  openModal(`<h3>Permissions: ${esc(u.username)}</h3>${permBoxes('pm',u.perms||[])}
  <p class="mut">Only admins can use Users, Invoice editor and delete invoices.</p>
  <div class="bar" style="margin-top:10px;justify-content:flex-end"><div style="flex:0"><button class="btn sec" onclick="closeModal()">Cancel</button></div><div style="flex:0"><button class="btn" onclick="savePerm('${id}')">Save</button></div></div>`);
}
async function savePerm(id){await run(sb.from('profiles').update({perms:permRead('pm')}).eq('id',id));closeModal();toast('Permissions saved');go('users')}
async function addUser(){
  const n=$('#u_n').value.trim().toLowerCase().replace(/[^a-z0-9._-]/g,''),pw=$('#u_p').value,role=$('#u_r').value;
  const em=($('#u_e').value.trim().toLowerCase())||(n+EMAIL_DOMAIN);
  if(!n||pw.length<6)return toast('Username and a password of 6+ characters are required',true);
  if(await emailFor(n))return toast('That username already exists',true);
  const sb2=supabase.createClient(CFG.url,CFG.key,{auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false}});
  const {data,error}=await sb2.auth.signUp({email:em,password:pw,options:{data:{username:n}}});
  if(error)return toast('Could not create user: '+error.message,true);
  if(!data.user||(data.user.identities&&data.user.identities.length===0))return toast('That email is already registered',true);
  const uid=data.user.id;let done=false;
  for(let k=0;k<12&&!done;k++){
    const {data:pr}=await sb.from('profiles').select('id').eq('id',uid).maybeSingle();
    if(pr){await run(sb.from('profiles').update({role,active:true,perms:permRead('np')}).eq('id',uid));done=true}else await sleep(400);
  }
  if(!done)return toast('User was created in Supabase Auth but has no profile row. Run supabase_update_v2.sql, then approve the user here.',true);
  toast('User created');go('users');
}
async function setRole(id,role){await run(sb.from('profiles').update({role}).eq('id',id));toast('Role updated')}
async function setActive(id,a){await run(sb.from('profiles').update({active:a}).eq('id',id));go('users')}

/* ---------------- Invoice editor (admin) ---------------- */
let EDLOGO='',EDOFF={};
window.addEventListener('message',e=>{if(e.data&&e.data.edrag){EDOFF[e.data.edrag]=[Math.round(e.data.x),Math.round(e.data.y)]}});
PAGES.settings=async()=>{
  const ly=getLY(),co=coInfo();EDLOGO=ly.logo||'';EDOFF=JSON.parse(JSON.stringify(ly.off||{}));
  const ck=(id,v,l)=>`<label class="chk"><input type="checkbox" id="${id}" ${v?'checked':''} onchange="edPrev()"> ${l}</label>`;
  const fm=sel=>[['a4','A4'],['a5','A5'],['th80','Thermal 80mm'],['dotf','Dot matrix - full page'],['doth','Dot matrix - half page']].map(f=>`<option value="${f[0]}" ${f[0]===sel?'selected':''}>${f[1]}</option>`).join('');
  $('#main').innerHTML=`<div class="top"><h2>Invoice editor</h2><div class="bar"><div style="width:220px"><label>Preview format</label><select id="e_fmt" onchange="edPrev()">${fm(ly.fmt)}</select></div><div style="flex:0"><button class="btn" onclick="edSave()">Save</button></div></div></div>
  <div class="edgrid"><div>
   <div class="card"><b>Shop details</b>
    <div class="row" style="margin-top:8px"><label>Shop name</label><input id="e_n" value="${esc(co.n)}" oninput="edPrev()"></div>
    <div class="row" style="margin-top:8px"><label>Address (each line on a new line)</label><textarea id="e_a" rows="3" oninput="edPrev()">${esc(co.a)}</textarea></div>
    <div class="bar" style="margin-top:8px"><div><label>Phone</label><input id="e_p" value="${esc(co.p)}" oninput="edPrev()"></div><div><label>Email</label><input id="e_em" value="${esc(ly.email)}" oninput="edPrev()"></div></div>
    <div class="row" style="margin-top:8px"><label>Website</label><input id="e_web" value="${esc(ly.web)}" oninput="edPrev()"></div></div>
   <div class="card"><b>Logo, header and sizes</b>
    <div class="row" style="margin-top:8px"><label>Logo image (PNG or JPG)</label><input id="e_lf" type="file" accept="image/*" onchange="edLogo(this)"></div>
    <img id="e_lt" src="${esc(EDLOGO)}" style="max-height:60px;margin-top:8px;display:${EDLOGO?'block':'none'}">
    <div style="margin-top:8px"><button class="btn sec sm" onclick="edLogoClear()">Remove logo</button></div>
    <div class="bar" style="margin-top:8px"><div><label>Logo height (px)</label><input id="e_lh" type="number" min="20" max="200" value="${ly.logoH}" oninput="edPrev()"></div>
     <div><label>Shop name size (px)</label><input id="e_ns" type="number" min="12" max="60" value="${ly.nameSize}" oninput="edPrev()"></div>
     <div><label>Invoice word size (px)</label><input id="e_ts" type="number" min="12" max="80" value="${ly.titleSize}" oninput="edPrev()"></div></div>
    <div class="bar" style="margin-top:8px"><div><label>Header layout</label><select id="e_al" onchange="edPrev()"><option value="left" ${ly.align==='left'?'selected':''}>Logo left, name beside it, INVOICE on right</option><option value="center" ${ly.align==='center'?'selected':''}>Centered</option></select></div>
     <div><label>Invoice title</label><input id="e_t" value="${esc(ly.title)}" oninput="edPrev()"></div></div>
    <div class="mut" style="margin-top:8px">Tip: drag any block in the preview (logo, shop name, INVOICE, customer, totals, rules, footer, signatures) to move it.</div>
    <div style="margin-top:8px"><button class="btn sec sm" onclick="EDOFF={};edPrev()">Reset positions</button></div></div>
   <div class="card"><b>Table columns</b>
    ${ck('e_ss',ly.showSerial,'Show serial number')}${ck('e_sw',ly.showWarranty,'Show warranty period')}${ck('e_su',ly.showUntil,'Show warranty end date')}</div>
   <div class="card"><b>Warranty rules and footer</b>
    <div class="row" style="margin-top:8px"><label>Rules heading</label><input id="e_tt" value="${esc(ly.termsTitle)}" oninput="edPrev()"></div>
    <div class="row" style="margin-top:8px"><label>Rules text (one rule per line; leave empty to hide)</label><textarea id="e_tm" rows="6" oninput="edPrev()">${esc(ly.terms)}</textarea></div>
    <div class="row" style="margin-top:8px"><label>Footer line</label><input id="e_f" value="${esc(ly.footer)}" oninput="edPrev()"></div></div>
   <div class="card"><b>Signatures and font</b>
    ${ck('e_sg',ly.showSig,'Show signature lines')}
    <div class="bar"><div><label>Left label</label><input id="e_s1" value="${esc(ly.sigL)}" oninput="edPrev()"></div><div><label>Middle label (optional)</label><input id="e_s2" value="${esc(ly.sigM)}" oninput="edPrev()"></div><div><label>Right label</label><input id="e_s3" value="${esc(ly.sigR)}" oninput="edPrev()"></div></div>
    <div class="bar" style="margin-top:8px"><div><label>Base font size</label><select id="e_fs" onchange="edPrev()">${[0,10,11,12,13,14,15].map(n=>`<option value="${n}" ${+ly.fontSize===n?'selected':''}>${n?n+' px':'Auto'}</option>`).join('')}</select></div>
     <div><label>Default print format</label><select id="e_df">${fm(ly.fmt)}</select></div></div></div>
  </div>
  <div class="card"><b>Live preview</b><div class="mut" style="margin-bottom:8px">Sample data. The logo and dragging do not apply to dot matrix.</div><div style="overflow:auto"><iframe id="e_pv" style="width:794px;height:760px;border:1px solid var(--line);background:#fff"></iframe></div></div></div>`;
  edPrev();
};
function edRead(){
  const g=id=>$('#'+id);
  return {co:{n:g('e_n').value,a:g('e_a').value,p:g('e_p').value},
   ly:{logo:EDLOGO,logoH:+g('e_lh').value||70,nameSize:+g('e_ns').value||24,titleSize:+g('e_ts').value||30,align:g('e_al').value,title:g('e_t').value||'INVOICE',email:g('e_em').value,web:g('e_web').value,
    showSerial:g('e_ss').checked,showWarranty:g('e_sw').checked,showUntil:g('e_su').checked,termsTitle:g('e_tt').value,terms:g('e_tm').value,footer:g('e_f').value,
    showSig:g('e_sg').checked,sigL:g('e_s1').value,sigM:g('e_s2').value,sigR:g('e_s3').value,fontSize:+g('e_fs').value||0,fmt:g('e_df').value,off:EDOFF}};
}
function edPrev(){
  const {co,ly}=edRead();
  const inv={inv_no:'INV-00001',inv_date:today(),customer_name:'Sample Customer',phone:'0771234567',address:'No 1, Sample Road, Kandy',subtotal:210000,discount:0,total:210000,pay_method:'Cash'};
  const ln=[{description:'Asus Vivobook X1504VA',details:'Intel Core i5 13th Gen\n16GB RAM, 512GB SSD\n15.6 inch FHD Display',serial:'SN1234567890',qty:1,unit_price:210000,warranty_months:12,amount:210000}];
  const fmt=$('#e_fmt').value;
  $('#e_pv').style.width={a4:'794px',a5:'560px',th80:'300px',dotf:'760px',doth:'760px'}[fmt];
  $('#e_pv').srcdoc=invDoc(inv,ln,fmt,{n:co.n||'Company',a:co.a,p:co.p},ly,true);
}
function edLogo(inp){
  const f=inp.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{const im=new Image();im.onload=()=>{const sc=Math.min(1,400/im.width),c=document.createElement('canvas');c.width=Math.round(im.width*sc);c.height=Math.round(im.height*sc);
    c.getContext('2d').drawImage(im,0,0,c.width,c.height);EDLOGO=c.toDataURL('image/png');$('#e_lt').src=EDLOGO;$('#e_lt').style.display='block';edPrev()};im.src=r.result};
  r.readAsDataURL(f);
}
function edLogoClear(){EDLOGO='';$('#e_lt').style.display='none';$('#e_lf').value='';edPrev()}
async function edSave(){
  const {co,ly}=edRead();
  const rows=[{key:'company_name',value:co.n},{key:'company_addr',value:co.a},{key:'company_phone',value:co.p},{key:'invoice_footer',value:ly.footer},{key:'invoice_layout',value:JSON.stringify(ly)}];
  await run(sb.from('settings').upsert(rows));
  rows.forEach(r=>settings[r.key]=r.value);
  $('#coName').textContent=settings.company_name||'Company';toast('Invoice layout saved');
}
</script>
</body>
</html>
